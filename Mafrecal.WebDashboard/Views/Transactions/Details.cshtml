@model TransactionViewModel

<h2 class="mb-4 fw-bold">
    <a href="/Transactions" class="btn btn-soft me-3">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
    Transaction Details - @Model.SourceEndpointId
</h2>

<div class="card card-soft shadow-sm mb-4 p-3">
    <p><strong>Source Endpoint:</strong> @Model.SourceEndpoint</p>
    <p><strong>Processado:</strong> @(Model.Processed ? "Sim" : "Não")</p>
    <p><strong>Erro:</strong> <pre style="white-space: pre-wrap; background-color:#fde2e2; padding:0.5rem; border-radius:0.25rem; color:#a94442;">@Model.Error</pre></p>
    <p><strong>Criado em:</strong> @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>
    <p><strong>Processado em:</strong> @(Model.ProcessedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</p>
</div>

<h4 class="mb-3">JSON Deserializado</h4>
<div class="card card-soft shadow-sm mb-4 p-3">
    <pre class="json-pre">@Newtonsoft.Json.JsonConvert.SerializeObject(Model.JsonData, Newtonsoft.Json.Formatting.Indented)</pre>
</div>



<style>
    body {
        background-color: #f4f6f9;
    }

    .card-soft {
        background-color: #ffffff;
        border-radius: 0.75rem;
        border: 1px solid #e0e0e0;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    }

    .btn-soft-warning {
        background-color: #fff2b3;
        border-color: #fff2b3;
        color: #1a1a1a;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
    }

        .btn-soft-warning:hover {
            background-color: #ffe680;
            border-color: #ffe680;
            color: #1a1a1a;
        }

    .btn-soft {
        background-color: #a3d2f5;
        border-color: #a3d2f5;
        color: #1a1a1a;
        padding: 0.4rem 0.8rem;
        border-radius: 0.5rem;
        text-decoration: none;
    }

        .btn-soft:hover {
            background-color: #7fbce8;
            border-color: #7fbce8;
            color: #1a1a1a;
        }

    pre.json-pre {
        background-color: #f0f4f8;
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
    }

    h2 .bi {
        vertical-align: -2px;
    }
</style>
